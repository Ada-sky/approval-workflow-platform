# Copy to .env.ghcr; never commit populated credentials.
# Full 40-character commit SHA from a successful GHCR publishing run.
# Both application images use this same version. Do not enter the sha- prefix.
HPOA_IMAGE_SHA=

# Set NEW, strong, independent passwords; do not reuse local database credentials.
DOCKER_DB_PASSWORD=
DOCKER_ROOT_PASSWORD=

# Optional demo seed only: at least 16 characters, at most 72 UTF-8 bytes.
HPOA_DEMO_PASSWORD=
