# Documentation template only: Spring Boot does not automatically load .env files.
# Supply approved values through your process environment or secret manager.
# Keep any populated .env file local; it is ignored by Git rules.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Guarded test profiles use their existing dedicated password variables instead.
INTEGRATION_DB_PASSWORD=
FLYWAY_TEST_DB_PASSWORD=

# Optional Vite proxy target; blank uses Vite's documented default.
BACKEND_URL=

# Docker only: use NEW independent secrets; never reuse local database credentials.
DOCKER_DB_PASSWORD=
DOCKER_ROOT_PASSWORD=
# Optional explicit demo-seed operation only: 16+ characters, at most 72 UTF-8 bytes.
HPOA_DEMO_PASSWORD=
